# Turso Database
# Get these from https://turso.tech after creating a database
TURSO_DATABASE_URL=libsql://your-database.turso.io
TURSO_AUTH_TOKEN=your-auth-token

# Google OAuth
# Get these from Google Cloud Console: https://console.cloud.google.com/apis/credentials
# Create OAuth 2.0 Client ID (Web application)
# Add redirect URIs:
#   Dev: http://localhost:5173/auth/callback/google
#   Prod: https://your-domain.vercel.app/auth/callback/google
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Auth.js Secret
# Generate with: openssl rand -base64 32
AUTH_SECRET=your-auth-secret

# Appmixer API
# Used to fetch E2E test flows from Appmixer instance
APPMIXER_USERNAME=
APPMIXER_PASSWORD=
APPMIXER_BASE_URL=

# GitHub API
# Personal access token for GitHub API (to avoid rate limiting)
# Create at: https://github.com/settings/tokens
# Required scopes: repo (for private repos) or public_repo (for public repos only)
SANITY_GITHUB_TOKEN=

# GitHub Repository Settings (optional - defaults shown)
# Use these to point to a fork or different branch
GITHUB_REPO_OWNER=Appmixer-ai
GITHUB_REPO_NAME=appmixer-connectors
GITHUB_REPO_BRANCH=dev

# Release page (/releases) — optional, defaults shown.
# Source = development; target = release branch the PRD marketplace is built from
# (the PR base); head = branch the release commits are pushed to (the PR head).
# The GitHub token needs push access to the head repo — and, with a fork as the
# head repo, the "workflow" scope (the branch brings upstream workflow changes).
# Point target and head at branches of a fork to try the release button safely.
RELEASE_SOURCE_REPO=Appmixer-ai/appmixer-connectors
RELEASE_SOURCE_BRANCH=dev
RELEASE_TARGET_REPO=Appmixer-ai/appmixer-components
RELEASE_TARGET_BRANCH=master
RELEASE_HEAD_REPO=vtalas/appmixer-components
RELEASE_HEAD_BRANCH=release

# Auth Hub — /authub switches between the environments; QA is offered once
# both of its variables are set. Tokens need the Auth Hub `admin` scope.
AUTH_HUB_URL_PROD=https://auth-hub.appmixer.com
AUTH_HUB_API_TOKEN_PROD=
AUTH_HUB_URL_QA=https://auth-hub.dev.appmixer.ai
AUTH_HUB_API_TOKEN_QA=

# Admin access (comma-separated emails for admin features like GitHub version comparison)
ADMIN_EMAILS=

# E2E test runner
# Secret for the cron endpoint /api/public/e2e-runner/tick (Vercel Cron sends it
# automatically as "Authorization: Bearer <CRON_SECRET>" when this env var is set)
CRON_SECRET=
# How many E2E flows may run at once (keep low — running everything at once kills the instance)
E2E_MAX_CONCURRENT=1
# Per-run completion timeout in seconds
E2E_RUN_TIMEOUT_SECONDS=480
